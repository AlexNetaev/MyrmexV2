```gitignore
# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Compiled and build artifacts
*.o
*.obj
*.so
*.a
*.dll
*.exe
*.out

# Dependencies
.venv/
venv/
env/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
coverage/
htmlcov/

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# Environment variables
.env
.env.local
.env.*

# Editors
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.hypothesis/
.coverage*

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre
.pyre/
```